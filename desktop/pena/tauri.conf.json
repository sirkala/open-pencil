{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pena",
  "mainBinaryName": "Pena",
  "identifier": "id.sirkala.pena",
  "build": {
    "beforeBuildCommand": "bun run generate:tauri-menu && bun run build:packages && vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Pena",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "create": false
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "icon": [
      "pena/icons/32x32.png",
      "pena/icons/128x128.png",
      "pena/icons/128x128@2x.png",
      "pena/icons/icon.icns",
      "pena/icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}
