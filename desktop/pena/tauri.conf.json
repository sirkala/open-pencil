{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pena",
  "mainBinaryName": "Pena",
  "identifier": "id.sirkala.pena",
  "build": {
    "beforeBuildCommand": "bun run generate:tauri-menu && bun run build:packages && vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Pena",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "updater",
        {
          "identifier": "pena-mcp",
          "description": "Starts the MCP server Pena ships, at Pena's own version.",
          "windows": ["main"],
          "permissions": [
            {
              "identifier": "shell:allow-spawn",
              "allow": [
                {
                  "name": "pena/bin/pena-mcp-http",
                  "sidecar": true,
                  "args": false
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "icon": [
      "pena/icons/32x32.png",
      "pena/icons/128x128.png",
      "pena/icons/128x128@2x.png",
      "pena/icons/icon.icns",
      "pena/icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": ["pena/bin/pena-mcp-http"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pena"]
      }
    },
    "updater": {
      "endpoints": []
    }
  }
}
