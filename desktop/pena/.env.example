# Copy to desktop/pena/.env (ignored by git); build.sh reads it.
# The path to Pena's updater private key, or the key itself.
TAURI_SIGNING_PRIVATE_KEY="$HOME/.tauri/pena.key"
# The password given to `bun tauri signer generate`, in single quotes, since the shell reads
# this file; leave it out to be asked during the build.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=''
